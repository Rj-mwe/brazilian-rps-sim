# ==============================================================================
# Configuração de Ambiente para Contêiner Podman / Docker (RPS-BR)
# ==============================================================================
# Copie este arquivo para 'docker/container.env' e ajuste conforme necessário:
#   cp docker/container.env.example docker/container.env

# Diretório no host onde os artefatos de build (build/, install/, log/) serão persistidos
CONTAINER_WS="${HOME}/Contêineres e VM's/brazilian-rps-sim"

# Nome e tag da imagem Podman/Docker construída
IMAGE_NAME="ros2-jazzy-gazebo:latest"

# Porta do Dashboard Web e API REST (FastAPI)
WEB_DASHBOARD_PORT=8000
