<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="arena_game_world">
    <!-- 1. PLUGINS ESSENCIAIS DO GAZEBO HARMONIC -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- 2. ILUMINAÇÃO & SOL -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 3. CHÃO DA ARENA (PISO CINZA ESCURO) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.2 0.22 0.25 1</ambient>
            <diffuse>0.3 0.32 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 4. PAREDES DE PROTEÇÃO DA ARENA (10m x 10m) -->
    <model name="arena_walls">
      <static>true</static>
      <link name="walls">
        <!-- Parede Norte -->
        <collision name="wall_n_col"><pose>0 5 0.5 0 0 0</pose><geometry><box><size>10.4 0.4 1.0</size></box></geometry></collision>
        <visual name="wall_n_vis"><pose>0 5 0.5 0 0 0</pose><geometry><box><size>10.4 0.4 1.0</size></box></geometry><material><ambient>0.1 0.5 0.8 1</ambient><diffuse>0.1 0.6 0.9 1</diffuse></material></visual>

        <!-- Parede Sul -->
        <collision name="wall_s_col"><pose>0 -5 0.5 0 0 0</pose><geometry><box><size>10.4 0.4 1.0</size></box></geometry></collision>
        <visual name="wall_s_vis"><pose>0 -5 0.5 0 0 0</pose><geometry><box><size>10.4 0.4 1.0</size></box></geometry><material><ambient>0.1 0.5 0.8 1</ambient><diffuse>0.1 0.6 0.9 1</diffuse></material></visual>

        <!-- Parede Leste -->
        <collision name="wall_e_col"><pose>5 0 0.5 0 0 0</pose><geometry><box><size>0.4 10.0 1.0</size></box></geometry></collision>
        <visual name="wall_e_vis"><pose>5 0 0.5 0 0 0</pose><geometry><box><size>0.4 10.0 1.0</size></box></geometry><material><ambient>0.1 0.5 0.8 1</ambient><diffuse>0.1 0.6 0.9 1</diffuse></material></visual>

        <!-- Parede Oeste -->
        <collision name="wall_w_col"><pose>-5 0 0.5 0 0 0</pose><geometry><box><size>0.4 10.0 1.0</size></box></geometry></collision>
        <visual name="wall_w_vis"><pose>-5 0 0.5 0 0 0</pose><geometry><box><size>0.4 10.0 1.0</size></box></geometry><material><ambient>0.1 0.5 0.8 1</ambient><diffuse>0.1 0.6 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 5. PILARES ESTÁTICOS / OBSTÁCULOS (VERMELHOS) -->
    <model name="pillar_nw"><static>true</static><pose>-2.5 2.5 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.4</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.4</radius><length>1.2</length></cylinder></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.9 0.2 0.2 1</diffuse></material></visual></link></model>
    <model name="pillar_ne"><static>true</static><pose>2.5 2.5 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.4</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.4</radius><length>1.2</length></cylinder></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.9 0.2 0.2 1</diffuse></material></visual></link></model>
    <model name="pillar_sw"><static>true</static><pose>-2.5 -2.5 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.4</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.4</radius><length>1.2</length></cylinder></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.9 0.2 0.2 1</diffuse></material></visual></link></model>
    <model name="pillar_se"><static>true</static><pose>2.5 -2.5 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.4</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.4</radius><length>1.2</length></cylinder></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.9 0.2 0.2 1</diffuse></material></visual></link></model>

    <!-- 6. ALVOS DINÂMICOS / PINOS DERRUBÁVEIS (AMARELOS E MAGENTA) -->
    <model name="target_pin_1"><pose>0 2.0 0.35 0 0 0</pose><link name="l"><inertial><mass>0.4</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.005</izz></inertia></inertial><collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.7</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.15</radius><length>0.7</length></cylinder></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>1.0 0.9 0.1 1</diffuse></material></visual></link></model>
    <model name="target_pin_2"><pose>0 -2.0 0.35 0 0 0</pose><link name="l"><inertial><mass>0.4</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.005</izz></inertia></inertial><collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.7</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.15</radius><length>0.7</length></cylinder></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>1.0 0.9 0.1 1</diffuse></material></visual></link></model>
    <model name="target_pin_3"><pose>2.0 0 0.35 0 0 0</pose><link name="l"><inertial><mass>0.4</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.005</izz></inertia></inertial><collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.7</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.15</radius><length>0.7</length></cylinder></geometry><material><ambient>0.9 0.1 0.8 1</ambient><diffuse>1.0 0.2 0.9 1</diffuse></material></visual></link></model>
    <model name="target_pin_4"><pose>-2.0 0 0.35 0 0 0</pose><link name="l"><inertial><mass>0.4</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.005</izz></inertia></inertial><collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.7</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.15</radius><length>0.7</length></cylinder></geometry><material><ambient>0.9 0.1 0.8 1</ambient><diffuse>1.0 0.2 0.9 1</diffuse></material></visual></link></model>
    <model name="target_pin_5"><pose>1.2 1.2 0.35 0 0 0</pose><link name="l"><inertial><mass>0.4</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.005</izz></inertia></inertial><collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.7</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.15</radius><length>0.7</length></cylinder></geometry><material><ambient>0.1 0.9 0.4 1</ambient><diffuse>0.2 1.0 0.5 1</diffuse></material></visual></link></model>
    <model name="target_pin_6"><pose>-1.2 -1.2 0.35 0 0 0</pose><link name="l"><inertial><mass>0.4</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.005</izz></inertia></inertial><collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.7</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.15</radius><length>0.7</length></cylinder></geometry><material><ambient>0.1 0.9 0.4 1</ambient><diffuse>0.2 1.0 0.5 1</diffuse></material></visual></link></model>

    <!-- 7. O ROBÔ EXPLORADOR / JOGADOR (GAME BOT) -->
    <model name="game_bot">
      <pose>0 0 0.15 0 0 0</pose>

      <!-- Chassis Central (Azul Metálico) -->
      <link name="chassis">
        <pose>0 0 0.05 0 0 0</pose>
        <inertial>
          <mass>2.5</mass>
          <inertia>
            <ixx>0.02</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.02</iyy><iyz>0</iyz>
            <izz>0.03</izz>
          </inertia>
        </inertial>
        <collision name="chassis_col">
          <geometry><box><size>0.5 0.3 0.15</size></box></geometry>
        </collision>
        <visual name="chassis_vis">
          <geometry><box><size>0.5 0.3 0.15</size></box></geometry>
          <material>
            <ambient>0.05 0.3 0.8 1</ambient>
            <diffuse>0.1 0.5 1.0 1</diffuse>
          </material>
        </visual>

        <!-- Roda Boba Dianteira (Caster) -->
        <collision name="caster_col">
          <pose>0.18 0 -0.05 0 0 0</pose>
          <geometry><sphere><radius>0.05</radius></sphere></geometry>
          <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
        </collision>
        <visual name="caster_vis">
          <pose>0.18 0 -0.05 0 0 0</pose>
          <geometry><sphere><radius>0.05</radius></sphere></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>

        <!-- Sensor LiDAR GPU no topo -->
        <sensor name="lidar" type="gpu_lidar">
          <pose>0.1 0 0.12 0 0 0</pose>
          <topic>scan</topic>
          <update_rate>15</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>180</samples>
                <resolution>1</resolution>
                <min_angle>-1.570796</min_angle>
                <max_angle>1.570796</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.12</min>
              <max>8.0</max>
              <resolution>0.01</resolution>
            </range>
          </ray>
          <always_on>1</always_on>
          <visualize>true</visualize>
        </sensor>
        <visual name="lidar_vis">
          <pose>0.1 0 0.1 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>

      <!-- Roda Esquerda -->
      <link name="left_wheel">
        <pose>-0.1 0.18 0.05 -1.570796 0 0</pose>
        <inertial><mass>0.6</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.002</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      </link>

      <!-- Roda Direita -->
      <link name="right_wheel">
        <pose>-0.1 -0.18 0.05 -1.570796 0 0</pose>
        <inertial><mass>0.6</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.002</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      </link>

      <!-- Juntas das Rodas -->
      <joint name="left_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>left_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <joint name="right_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>right_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <!-- Plugin de Tração Diferencial do Gazebo -->
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.36</wheel_separation>
        <wheel_radius>0.1</wheel_radius>
        <max_linear_acceleration>2.0</max_linear_acceleration>
        <min_linear_acceleration>-2.0</min_linear_acceleration>
        <max_angular_acceleration>4.0</max_angular_acceleration>
        <min_angular_acceleration>-4.0</min_angular_acceleration>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>chassis</child_frame_id>
      </plugin>
    </model>
  </world>
</sdf>
