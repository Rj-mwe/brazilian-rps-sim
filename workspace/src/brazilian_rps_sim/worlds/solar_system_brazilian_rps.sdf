<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="solar_system_rps_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 0</gravity>

    <!-- 🌌 ESPAÇO SIDERAL PROFUNDO -->
    <scene>
      <ambient>0.0 0.0 0.0 1.0</ambient>
      <background>0.001 0.001 0.008 1.0</background>
      <grid>false</grid>
      <shadows>true</shadows>
    </scene>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />

    <!-- ☀️ O SOL (Origem 0, 0, 0) -->
    <light type="point" name="sun_omni_light">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 0 0 0 0</pose>
      <diffuse>1.0 0.98 0.92 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <attenuation>
        <range>50000</range>
        <constant>0.05</constant>
        <linear>0.00001</linear>
        <quadratic>0.0000001</quadratic>
      </attenuation>
    </light>

    <model name="sun">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="sun_link">
        <visual name="sun_sphere">
          <geometry><sphere><radius>45.0</radius></sphere></geometry>
          <material>
            <ambient>1.0 0.9 0.2 1</ambient>
            <diffuse>1.0 0.95 0.3 1</diffuse>
            <emissive>1.0 0.9 0.3 1</emissive>
          </material>
        </visual>
      </link>
      <plugin filename="libCelestialMechanicsPlugin.so" name="celestial_sim::CelestialMechanicsPlugin">
        <body_type>sun</body_type>
        <time_scale>86400.0</time_scale>
      </plugin>
    </model>

    <!-- 🌟 TRILHA 3D DA ÓRBITA DA TERRA (glTF 2.0 com Dourado PBR Embutido) -->
    <model name="earth_orbit_trail">
      <pose>0 0 0 0 0 0</pose>
      <link name="earth_trail_link">
        <visual name="earth_trail_vis">
          <geometry>
            <mesh>
              <uri>package://brazilian_rps_sim/meshes/earth_orbit_ring.gltf</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
      <plugin filename="libCelestialMechanicsPlugin.so" name="celestial_sim::CelestialMechanicsPlugin">
        <body_type>earth_trail</body_type>
        <time_scale>86400.0</time_scale>
      </plugin>
    </model>

    <!-- 🌍 A TERRA (Alinhamento Polar: Polo Norte em +Z, Greenwich em +X) -->
    <model name="earth">
      <pose>1200 0 0 0 0 0</pose>
      <link name="earth_link">
        <collision name="earth_col">
          <geometry><sphere><radius>6.378</radius></sphere></geometry>
        </collision>
        <visual name="earth_surface">
          <!-- Rotação de alinhamento polar: Roll 90° para posicionar o Polo Norte no topo (+Z) -->
          <pose>0 0 0 1.57079632679 0 0</pose>
          <geometry>
            <sphere><radius>6.378</radius></sphere>
          </geometry>
          <material>
            <diffuse>1.0 1.0 1.0 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
            <pbr>
              <metal>
                <albedo_map>package://brazilian_rps_sim/materials/textures/earth_day_albedo_2k.jpg</albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.85</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
      <plugin filename="libCelestialMechanicsPlugin.so" name="celestial_sim::CelestialMechanicsPlugin">
        <body_type>earth</body_type>
        <time_scale>86400.0</time_scale>
      </plugin>
    </model>

    <!-- 🌀 TRILHA 3D DA ÓRBITA DA LUA (glTF 2.0 com Ciano PBR Embutido) -->
    <model name="moon_orbit_trail">
      <pose>1200 0 0 0 0 0</pose>
      <link name="trail_link">
        <visual name="trail_vis">
          <geometry>
            <mesh>
              <uri>package://brazilian_rps_sim/meshes/moon_orbit_ring.gltf</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
      <plugin filename="libCelestialMechanicsPlugin.so" name="celestial_sim::CelestialMechanicsPlugin">
        <body_type>moon_trail</body_type>
        <time_scale>86400.0</time_scale>
      </plugin>
    </model>

    <!-- 🌕 A LUA (Raio: 1.737 km | Distância: 384.400 km | Órbita a 5.145°) -->
    <model name="moon">
      <pose>1584.4 0 0 0 0 0</pose>
      <link name="moon_link">
        <collision name="moon_col">
          <geometry><sphere><radius>1.737</radius></sphere></geometry>
        </collision>
        <visual name="moon_surface">
          <geometry><sphere><radius>1.737</radius></sphere></geometry>
          <material>
            <ambient>0.5 0.5 0.55 1.0</ambient>
            <diffuse>0.7 0.7 0.75 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
      <plugin filename="libCelestialMechanicsPlugin.so" name="celestial_sim::CelestialMechanicsPlugin">
        <body_type>moon</body_type>
        <time_scale>86400.0</time_scale>
      </plugin>
    </model>

    <!-- 🛰️ SATÉLITE 1 DO RPS-BR: RPS-GEO (Âncora sobre Brasília - 50°W) -->
    <model name="rps_geo_satellite">
      <pose>1227.1 -32.3 0.0 0 0 0</pose>
      <link name="bus_geo">
        <visual name="v_bus">
          <geometry><box><size>1.6 1.6 2.2</size></box></geometry>
          <material>
            <ambient>0.85 0.65 0.1 1.0</ambient>
            <diffuse>0.95 0.75 0.15 1.0</diffuse>
            <specular>0.8 0.7 0.3 1.0</specular>
          </material>
        </visual>
        <visual name="v_solar">
          <geometry><box><size>6.5 0.9 0.12</size></box></geometry>
          <material>
            <ambient>0.05 0.15 0.7 1.0</ambient>
            <diffuse>0.1 0.25 0.9 1.0</diffuse>
          </material>
        </visual>
        <visual name="v_marker">
          <pose>0 0 1.2 0 0 0</pose>
          <geometry><sphere><radius>0.4</radius></sphere></geometry>
          <material><ambient>0.9 0.1 0.1 1.0</ambient><diffuse>1.0 0.1 0.1 1.0</diffuse></material>
        </visual>
      </link>
      <plugin filename="libOrbitalMotionPlugin.so" name="brazilian_rps::OrbitalMotionPlugin">
        <semi_major_axis>42.164</semi_major_axis>
        <eccentricity>0.0</eccentricity>
        <inclination_deg>0.0</inclination_deg>
        <raan_deg>0.0</raan_deg>
        <arg_perigee_deg>0.0</arg_perigee_deg>
        <mean_anomaly_deg>310.0</mean_anomaly_deg>
        <time_scale>86400.0</time_scale>
        <heliocentric>true</heliocentric>
      </plugin>
    </model>

    <!-- 🛰️ SATÉLITE 2 DO RPS-BR: RPS-IGSO (Figura-8 sobre o Território Brasileiro) -->
    <model name="rps_igso_satellite">
      <pose>1227.1 -32.3 0.0 0 0 0</pose>
      <link name="bus_igso">
        <visual name="v_bus">
          <geometry><cylinder><radius>1.0</radius><length>2.4</length></cylinder></geometry>
          <material>
            <ambient>0.7 0.75 0.8 1.0</ambient>
            <diffuse>0.85 0.9 0.95 1.0</diffuse>
            <specular>0.9 0.9 0.9 1.0</specular>
          </material>
        </visual>
        <visual name="v_solar">
          <geometry><box><size>0.9 6.5 0.12</size></box></geometry>
          <material>
            <ambient>0.05 0.15 0.7 1.0</ambient>
            <diffuse>0.1 0.25 0.9 1.0</diffuse>
          </material>
        </visual>
        <visual name="v_marker">
          <pose>0 0 1.3 0 0 0</pose>
          <geometry><sphere><radius>0.5</radius></sphere></geometry>
          <material><ambient>0.1 0.9 0.9 1.0</ambient><diffuse>0.2 1.0 1.0 1.0</diffuse></material>
        </visual>
      </link>
      <plugin filename="libOrbitalMotionPlugin.so" name="brazilian_rps::OrbitalMotionPlugin">
        <semi_major_axis>42.164</semi_major_axis>
        <eccentricity>0.06</eccentricity>
        <inclination_deg>29.0</inclination_deg>
        <raan_deg>310.0</raan_deg>
        <arg_perigee_deg>270.0</arg_perigee_deg>
        <mean_anomaly_deg>0.0</mean_anomaly_deg>
        <time_scale>86400.0</time_scale>
        <heliocentric>true</heliocentric>
      </plugin>
    </model>

  </world>
</sdf>
